# .julieignore — code-intelligence exclusion patterns (gitignore syntax)
# Generated by Miller on 2026-07-14: no .julieignore existed, so Miller
# seeded baseline noise patterns plus auto-detected vendor/build directories.
# Edit freely — Miller never overwrites or appends to this file. Excluded files
# stay out of symbol extraction and search; delete a line to re-include its files
# on the next scan. To opt out entirely, keep an empty .julieignore.

# Baseline noise (logs are index noise; use Miller's log tooling to read them)
.miller/
*.log

# Auto-detected vendor/build directories
.opencode/node_modules/
.opencode/node_modules/@opencode-ai/plugin/dist/
.opencode/node_modules/@opencode-ai/sdk/dist/
.opencode/node_modules/effect/dist/
.opencode/node_modules/find-my-way-ts/dist/
.opencode/node_modules/msgpackr/dist/
.opencode/node_modules/multipasta/dist/
.opencode/node_modules/uuid/dist/
.opencode/node_modules/yaml/browser/dist/
.opencode/node_modules/yaml/dist/
